{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "rules": {
    "effecttsgo/unstable-api-usage": "off"
  },
  "overrides": [
    {
      "files": ["src/domain/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/application/**",
                  "**/adapters/**",
                  "**/server/**",
                  "**/cli/**",
                  "**/worker/**",
                  "@temporalio/*"
                ],
                "message": "The domain imports nothing from outer layers or Temporal."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cli/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/adapters/**",
                  "**/server/**",
                  "**/worker/**",
                  "@effect/sql-pg",
                  "@temporalio/*"
                ],
                "message": "The CLI reaches the factory only through the API client."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/cli/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
